{
  "name": "@kanso-labs/unplugin-style-dictionary",
  "version": "0.10.3",
  "description": "Compile Style Dictionary design tokens ahead of your bundler (Vite, Rolldown, Rollup, or Webpack) from a single unplugin-based plugin, with automatic watching and rebuilding under Vite",
  "keywords": [
    "unplugin",
    "vite",
    "rolldown",
    "rollup",
    "webpack",
    "style-dictionary",
    "design-tokens",
    "tokens"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "default": "./dist/rolldown.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanso-labs/unplugin-style-dictionary.git"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "clean": "rimraf dist",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware . && eslint . && npm run format:check",
    "package:check": "publint && attw --pack . --profile esm-only && node scripts/check-package.mjs",
    "peers:check": "node scripts/check-peers.mjs",
    "prepare": "husky || true",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Kanso Labs <kanso.labs.org@gmail.com>",
  "dependencies": {
    "json5": "2.2.3",
    "picomatch": "4.0.7",
    "tinyglobby": "0.2.17",
    "unplugin": "3.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codecov/rollup-plugin": "2.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@rspack/core": "2.2.6",
    "@types/node": "26.6.1",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-oxlint": "1.83.0",
    "eslint-plugin-perfectionist": "5.11.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "rolldown": "1.2.9",
    "rollup": "4.63.4",
    "semver": "7.8.5",
    "style-dictionary": "5.5.4",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "webpack": "5.111.1"
  },
  "peerDependencies": {
    "@rspack/core": "*",
    "rolldown": "*",
    "rollup": "*",
    "style-dictionary": "^5.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "webpack": "*"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  }
}
