{
  "name": "@kanso-labs/unplugin-style-dictionary",
  "version": "0.2.6",
  "description": "Compile Style Dictionary design tokens ahead of your bundler (Vite, Rolldown, Rollup, or Webpack) from a single unplugin-based plugin, with automatic watching and rebuilding under Vite",
  "keywords": [
    "unplugin",
    "vite",
    "rolldown",
    "rollup",
    "webpack",
    "style-dictionary",
    "design-tokens",
    "tokens"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/cjs/vite.d.cts",
        "default": "./dist/cjs/vite.cjs"
      }
    },
    "./rolldown": {
      "import": {
        "types": "./dist/rolldown.d.ts",
        "default": "./dist/rolldown.js"
      },
      "require": {
        "types": "./dist/cjs/rolldown.d.cts",
        "default": "./dist/cjs/rolldown.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.ts",
        "default": "./dist/rollup.js"
      },
      "require": {
        "types": "./dist/cjs/rollup.d.cts",
        "default": "./dist/cjs/rollup.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/cjs/webpack.d.cts",
        "default": "./dist/cjs/webpack.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanso-labs/unplugin-style-dictionary.git"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "clean": "rimraf dist",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware . && eslint . && npm run format:check",
    "prepare": "husky",
    "test": "vitest run"
  },
  "peerDependencies": {
    "rolldown": "*",
    "rollup": "*",
    "style-dictionary": "^5.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "webpack": "*"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "eslint-plugin-oxlint": "1.78.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "rollup": "4.62.5",
    "style-dictionary": "5.5.2",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "webpack": "5.109.2"
  },
  "dependencies": {
    "unplugin": "3.3.0"
  }
}
