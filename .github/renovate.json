{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "automerge": true,
    "enabled": true
  },
  "minimumReleaseAge": null,
  "mise": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Renovate's own config:recommended sets semanticCommitType through a packageRule, and packageRules beat top-level config. Setting it at the top level therefore does nothing at all: every upgrade stays chore and cuts no release.",
      "matchPackageNames": ["*"],
      "semanticCommitType": "deps"
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "commitlint",
      "matchPackageNames": ["@commitlint/**"]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "@eslint/**",
        "eslint",
        "eslint-config-**",
        "eslint-plugin-**",
        "typescript-eslint"
      ]
    },
    {
      "groupName": "vitest",
      "matchPackageNames": ["@vitest/**", "vitest"]
    }
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "recreateWhen": "always",
  "semanticCommitScope": null,
  "semanticCommits": "enabled"
}
