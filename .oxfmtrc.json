{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "ignorePatterns": [".claude/worktrees", "CHANGELOG.md", "LICENSE.md"],
  "printWidth": 80,
  "proseWrap": "always",
  "semi": false,
  "singleQuote": true,
  "sortPackageJson": false,
  "trailingComma": "all"
}
